// Debug build — points at local Next.js / Drupal host.
// The /$()/ trick prevents xcconfig from treating // as a comment.
API_BASE_URL = http:/$()/localhost:3000
X_CLIENT_ID = REPLACE_ME_WITH_X_CLIENT_ID
// Phase D-A: paste the simple_oauth consumer UUID (public client).
OAUTH_CLIENT_ID = VERIFY-CONSUMER-UUID
GOOGLE_IOS_CLIENT_ID = REPLACE_ME_GOOGLE_IOS_CLIENT_ID
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.REPLACE_ME
ENVIRONMENT = development

// Local overrides — paste your real X_CLIENT_ID / OAUTH_CLIENT_ID into
// Configuration/Debug.local.xcconfig (gitignored).
#include? "Debug.local.xcconfig"
