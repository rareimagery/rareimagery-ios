// Copy this file to `Debug.local.xcconfig` and fill in real values.
// The actual file is gitignored.
//
// X (legacy BFF path):
//   developer.x.com → your app → Keys and tokens → OAuth 2.0 Client ID
//   Callback: rareimagery://auth/callback
//
// Drupal simple_oauth (primary — Task i2):
//   Admin → Simple OAuth → Consumers → RareImagery iOS (public/PKCE)
//   Redirect URI: rareimagery://oauth/callback
//   Paste the consumer UUID below.

X_CLIENT_ID = paste_your_x_oauth_client_id_here
# Optional: when ADR-023 broker infra is live, paste the Drupal simple_oauth
# consumer UUID here. While unset/placeholder, TestFlight uses legacy JWT sign-in.
OAUTH_CLIENT_ID = paste_your_simple_oauth_consumer_uuid_here

# Local dev note: Debug uses API_BASE_URL=http://localhost:3000 for the BFF.
# Drupal OAuth (/oauth/token) is on production or a local Drupal :8080 stack.
# For full broker testing, point API_BASE_URL at https://rareimagery.net or
# add a future DRUPAL_BASE_URL split — see ai-memory/runbooks/ios-oauth-signin.md
