// Release build — production Drupal / BFF host.
API_BASE_URL = https:/$()/rareimagery.net
X_CLIENT_ID = REPLACE_ME_WITH_X_CLIENT_ID
OAUTH_CLIENT_ID = VERIFY-CONSUMER-UUID
GOOGLE_IOS_CLIENT_ID = REPLACE_ME_GOOGLE_IOS_CLIENT_ID
// Must be RFC1738-safe (letters, digits, . + - only — no underscores). Copy from Google Cloud iOS client.
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.set-in-release-local-xcconfig
ENVIRONMENT = production

// Note: CODE_SIGN_IDENTITY[sdk=iphoneos*] = Apple Distribution is set at the
// target level in project.yml so xcodegen emits it into the .pbxproj (target
// settings override xcconfig).

// Local overrides — paste production IDs into Configuration/Release.local.xcconfig
// (gitignored). For TestFlight you can also leave this and inject via CI.
#include? "Release.local.xcconfig"
